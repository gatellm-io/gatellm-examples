# Copy to .env (git-ignored) and fill in the access key.
# The key is read from the environment only; never commit it.

# Where your gateway listens. Local Docker deployment is the default.
GATELLM_BASE_URL=http://localhost:7890

# Gateway access key, created in the console (http://localhost:7890 → Access keys).
GATELLM_API_KEY=

# Any model name your gateway exposes. This is a placeholder — replace it with one
# from your own catalog (console → Models).
GATELLM_MODEL=claude-opus-5
